APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Lodgify
# ---------------------------------------------------------------------------
# Required. Without it the site has no cottages, no availability and no prices.
# Lodgify dashboard -> Settings -> Public API.
LODGIFY_API_KEY=

# Leave the rest at their defaults unless you have a reason. Every option is
# documented in config/lodgify.php, which is worth reading once.
# LODGIFY_CACHE_AVAILABILITY=300
# LODGIFY_RATES_PARAM_STYLE=pascal

# Slug for the Lodgify hosted checkout, used only while
# BOOKING_DIRECT_PAYMENTS=false.
LODGIFY_CHECKOUT_SLUG=
LODGIFY_CHECKOUT_CURRENCY=CAD

# Booking WRITE endpoints. Defaults are in config/lodgify.php; the request-body
# field names are NOT verified against a live account. Before enabling direct
# payments in production, run:
#     php artisan lodgify:probe-booking-write --property=<id> --confirm
# and copy the accepted field names into config/lodgify.php -> write.field_map
# (or the LODGIFY_FIELD_* vars).
# LODGIFY_RECORD_PAYMENT_PATH=

# ---------------------------------------------------------------------------
# Direct booking + Stripe payments
# ---------------------------------------------------------------------------
# OFF by default. False keeps the old behaviour: /book/{slug} hands the guest to
# Lodgify's hosted checkout and none of the payments code runs. This is the
# rollback switch — see Docs/05-payments-and-booking.md.
BOOKING_DIRECT_PAYMENTS=false

# Test keys while developing. sk_test_* / whsec_* only — a live key does not
# belong in a file that is committed as an example.
STRIPE_KEY=
STRIPE_SECRET=

# The endpoint signing secret, NOT the API key. Stripe issues a different one per
# webhook endpoint. Get it from `stripe listen` locally, or from the endpoint's
# page in the dashboard. Without it every webhook is rejected and paid bookings
# are silently stranded.
STRIPE_WEBHOOK_SECRET=

# Where "guest paid but Lodgify was not updated" alerts go. This is the one
# failure that needs a human, so set it before going live.
BOOKING_ALERT_EMAIL=

BOOKING_SUPPORT_PHONE=902-398-1020
BOOKING_SUPPORT_EMAIL=

# How long a deposit link stays valid. This ALSO bounds how long an unpaid
# reservation sits `Open` in Lodgify holding dates it has not paid for, because
# an Open reservation does not block the calendar. Keep it short.
BOOKING_DEPOSIT_LINK_TTL=48

# Days before arrival that the balance link goes out.
BOOKING_BALANCE_LEAD_DAYS=30

# Stays starting inside this many days are charged in one payment instead of
# deposit-then-balance.
BOOKING_FULL_PAYMENT_WITHIN_DAYS=14

# ---------------------------------------------------------------------------
# Google reviews (optional; /reviews degrades to a notice without them)
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACE_ID=

# ---------------------------------------------------------------------------
# First admin, for `php artisan db:seed --class=AdminUserSeeder`
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME="Site Admin"
